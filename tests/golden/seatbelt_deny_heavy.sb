(version 1)
(deny default)
(import "system.sb")
; process
(allow process-exec)
(allow process-fork)
(allow ipc-posix-shm)
(allow ipc-posix-sem)
(allow signal (target same-sandbox))
; metadata
(allow file-read-metadata)
(allow file-read-data (path-ancestors (param "A0")) (path-ancestors (param "A1")))
; system_read
(allow file-read* (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/private/etc") (subpath "/private/var/select") (subpath "/Library/Developer/CommandLineTools"))
(allow file-read* file-write* (regex #"^/dev/fd/[0-9]+$") (literal "/dev/stdin") (literal "/dev/stdout") (literal "/dev/stderr"))
(allow file-read* (regex #"^/private/var/folders/[^/]+/[^/]+/T/xcrun_db$"))
; grants
(allow file-read* file-write* (subpath (param "W0")) (subpath (param "W1")))
; guard
(deny file-read-data file-read-xattr file-write* (regex (param "G0")) (regex (param "G1")))
; template_allow
(allow file-read-data file-read-xattr file-write* (regex (param "G2")) (regex (param "G3")) (literal (param "W2")))
; host_services
(deny process-exec (literal "/bin/launchctl"))
; policy_deny
(deny file-read-data file-read-metadata file-read-xattr file-test-existence file-map-executable file-write* (subpath (param "F0")))
(deny file-read-data file-read-metadata file-read-xattr file-test-existence file-map-executable file-write* (subpath (param "F1")))
(deny file-read-data file-read-metadata file-read-xattr file-test-existence file-map-executable file-write* (regex (param "G4")))
(deny file-write* (subpath (param "F2")))
(deny file-write* (regex (param "G5")))
; floor
